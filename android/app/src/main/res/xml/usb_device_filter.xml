<?xml version="1.0" encoding="utf-8"?>
<!-- 插上这些 USB 转串口芯片时自动提示打开本 App -->
<resources>
    <!-- CH340 / CH341（最常见的那种蓝色小板） -->
    <usb-device vendor-id="6790" />            <!-- 0x1A86 -->
    <!-- CP210x -->
    <usb-device vendor-id="4292" />            <!-- 0x10C4 -->
    <!-- FTDI -->
    <usb-device vendor-id="1027" />            <!-- 0x0403 -->
    <!-- Prolific PL2303 -->
    <usb-device vendor-id="1659" />            <!-- 0x067B -->
    <!-- 通用 CDC-ACM 类（很多国产读写器自带 USB 转串口） -->
    <usb-device class="2" subclass="0" protocol="0" />
</resources>
