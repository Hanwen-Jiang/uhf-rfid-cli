<?xml version="1.0" encoding="utf-8"?>
<!--
  主页。

  上面是「控制面板」：<b>固定高度</b>，所以内容怎么变版面都不跳。
  它有两种状态，在同一个框里切换：
    · 平时   —— 状态、命中信息、EPC/TID、校验结果
    · 连接中 —— 进度条 + 当前步骤（同一个框，所以也不会跳版）
  反馈走边框动画（不缩放，不会把周围挤开）。

  下面是操作区：读标签 / 上传到云端，写入 / 挑标签。
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- ============ 控制面板（固定高度） ============ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/panel"
            android:layout_width="match_parent"
            android:layout_height="212dp"
            app:cardBackgroundColor="#FAFAFA"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="#B0BEC5"
            app:strokeWidth="2dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- 平时显示的内容 -->
                <LinearLayout
                    android:id="@+id/panelBody"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/statusText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="@string/no_device_hint"
                        android:textColor="#546E7A"
                        android:textSize="12sp" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/hitName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="#0D47A1"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/hitSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:fontFamily="monospace"
                        android:textColor="#1565C0"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="#E0E0E0" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/epcText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="middle"
                        android:fontFamily="monospace"
                        android:maxLines="1"
                        android:text="—"
                        android:textIsSelectable="true"
                        android:textSize="14sp" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tidText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="middle"
                        android:fontFamily="monospace"
                        android:maxLines="1"
                        android:text="—"
                        android:textIsSelectable="true"
                        android:textSize="14sp" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/checkText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 连接中显示：进度条 + 当前步骤 -->
                <LinearLayout
                    android:id="@+id/connectBox"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:visibility="gone">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/connectTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/connecting"
                        android:textColor="#0D47A1"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/connectBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:indeterminate="true"
                        app:indicatorColor="#1E88E5"
                        app:trackColor="#E3F2FD"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="6dp" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/connectStep"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="#546E7A"
                        android:textSize="13sp" />
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ 操作区 ============ -->
        <!--
          读标签 + 右侧上传热区。和写标签那个一样：<b>一个</b>按钮，
          不用两个拼（两个各自画背景和阴影，永远有接缝）。
        -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/readBtn"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingEnd="72dp"
                android:text="@string/read_short"
                android:textSize="16sp"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_read"
                app:iconGravity="textStart" />

            <!--
              右侧热区 = 上传到云端。
              分隔线和图标都放在<b>热区内部</b> —— 热区 Z 比按钮高，单独摆在外面的
              分隔线/图标 Z 低，会被热区整个盖住，看不见（踩过）。
            -->
            <LinearLayout
                android:id="@+id/uploadZone"
                android:layout_width="60dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:elevation="6dp"
                android:focusable="false"
                android:gravity="center"
                android:orientation="horizontal"
                android:outlineProvider="none">

                <View
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:background="#66FFFFFF" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="17dp"
                    android:contentDescription="@string/cloud_upload"
                    android:src="@drawable/ic_upload" />
            </LinearLayout>
        </FrameLayout>

        <!--
          写标签：<b>一个</b>按钮，右边划一条热区当"下拉"。
          圆角交给 cornerRadius（注意：设了它就会盖掉 shapeAppearanceOverlay）。
        -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/writeBtn"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:ellipsize="end"
                android:enabled="false"
                android:maxLines="1"
                android:paddingEnd="72dp"
                android:text="@string/write_now"
                android:textSize="15sp"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_drop_down"
                app:iconGravity="end"
                app:iconPadding="16dp" />

            <!-- 同 uploadZone：分隔线放热区内部，Z 也高过按钮 -->
            <LinearLayout
                android:id="@+id/dropZone"
                android:layout_width="60dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:elevation="6dp"
                android:focusable="false"
                android:gravity="center"
                android:orientation="horizontal"
                android:outlineProvider="none">

                <View
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:background="#66FFFFFF" />
            </LinearLayout>
        </FrameLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
