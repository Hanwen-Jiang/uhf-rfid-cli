<?xml version="1.0" encoding="utf-8"?>
<!--
  主页。

  上面是「控制面板」：固定高度，读到的状态、命中信息、EPC/TID、校验结果都在这块里，
  所以内容变化时版面不会跳。反馈走边框动画 —— 不缩放、不撑空间。

  下面是操作区：读标签 / 上传到云端，选择标签… / 写入。
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- ============ 控制面板（固定高度，内容变化不跳版） ============ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/panel"
            android:layout_width="match_parent"
            android:layout_height="212dp"
            app:cardBackgroundColor="#FAFAFA"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="#B0BEC5"
            app:strokeWidth="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="14dp">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/statusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/no_device_hint"
                    android:textColor="#546E7A"
                    android:textSize="12sp" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/hitName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#0D47A1"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/hitSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:fontFamily="monospace"
                    android:textColor="#1565C0"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:background="#E0E0E0" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/epcText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:text="—"
                    android:textIsSelectable="true"
                    android:textSize="14sp" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tidText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:text="—"
                    android:textIsSelectable="true"
                    android:textSize="14sp" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/checkText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ 操作区 ============ -->
        <!--
          读标签 + 右侧上传热区。和写标签那个一样：<b>一个</b>按钮，
          不用两个拼（两个各自画背景和阴影，永远有接缝）。
        -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/readBtn"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingEnd="64dp"
                android:text="@string/read_short"
                android:textSize="16sp"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_read"
                app:iconGravity="textStart" />

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="56dp"
                android:background="#66FFFFFF" />

            <!-- 透明热区 = 上传到云端 -->
            <!--
              热区必须有比按钮更高的 Z。
              MaterialButton 默认带 2dp elevation，而 ViewGroup 从 API 21 起是
              **按 Z 值**（不是 XML 顺序）分发触摸的 —— Z 低的控件就算写在后面、
              画在上面，按钮仍然会把点击吃掉。踩过：按钮一从禁用变可用，
              下拉就点不动了（禁用时不响应触摸，热区才拿得到）。
              outlineProvider="none" 是为了提 Z 但不投影。
            -->
            <View
                android:id="@+id/uploadZone"
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:elevation="6dp"
                android:focusable="false"
                android:outlineProvider="none" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="16dp"
                android:contentDescription="@string/cloud_upload"
                android:src="@drawable/ic_upload" />
        </FrameLayout>

        <!--
          写标签：<b>一个</b>按钮，右边划一条热区当"下拉"。
          不用两个按钮拼 —— 那样各自画背景和阴影，永远有接缝、也不像一个控件。
          圆角交给 cornerRadius（注意：设了它就会盖掉 shapeAppearanceOverlay，
          两边别同时写）。
        -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/writeBtn"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:ellipsize="end"
                android:enabled="false"
                android:maxLines="1"
                android:paddingEnd="64dp"
                android:text="@string/write_now"
                android:textSize="15sp"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_drop_down"
                app:iconGravity="end"
                app:iconPadding="16dp" />

            <!-- 分隔线：让"这里可以下拉"看得出来 -->
            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="56dp"
                android:background="#66FFFFFF" />

            <!-- 透明热区，只为接下拉的点击 -->
            <!-- 同 uploadZone：Z 必须高过按钮，否则点击会被按钮吃掉 -->
            <View
                android:id="@+id/dropZone"
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:elevation="6dp"
                android:focusable="false"
                android:outlineProvider="none" />
        </FrameLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
