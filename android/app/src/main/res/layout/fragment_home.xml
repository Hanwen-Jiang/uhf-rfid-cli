<?xml version="1.0" encoding="utf-8"?>
<!--
  主页：读标签（顺带自动上传）+ 从库里挑一颗写进去。
  刻意不放说明文字 —— 按钮自己说明自己，写不下才加一句。
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status"
            android:padding="10dp"
            android:text="@string/no_device_hint"
            android:textSize="13sp" />

        <!-- 命中云端 / 刚上传 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/hitCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            app:cardBackgroundColor="#E3F2FD"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="#1E88E5"
            app:strokeWidth="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/hitLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="@string/hit_label"
                    android:textColor="#1565C0"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/hitName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#0D47A1"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/hitSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="monospace"
                    android:textColor="#1565C0"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 读到的值 -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/epcText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="monospace"
            android:text="—"
            android:textIsSelectable="true"
            android:textSize="15sp" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tidText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="—"
            android:textIsSelectable="true"
            android:textSize="15sp" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/checkText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- 读：两个按钮并排，自动上传失败时手点右边那个重传 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/readBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/read_short"
                android:textSize="16sp"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_read" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/uploadBtn"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/cloud_upload"
                android:textSize="16sp"
                app:cornerRadius="10dp" />
        </LinearLayout>

        <!-- 写：挑一颗 -> 再点「写入」。挑的时候只选中，不动标签。 -->
        <!-- 写标签就这一个按钮：点开挑一颗 -> 确认 -> 写 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/pickWriteBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/write_pick"
            android:textSize="16sp"
            app:cornerRadius="10dp" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/writeTargetText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:textSize="13sp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
