<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- USB Host：手机通过 OTG 线直接跟读写器讲串口 -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!-- WiFi 模式：连读写器自带的网口，或连电脑/树莓派上的桥 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@style/Theme.UhfRfid">

        <!--
          launchMode=singleTop + 完整的 configChanges：转屏、插拔 USB、切换深色模式
          等都不会重建 Activity，也就不会出现「用着用着 App 自己重启、连接掉了」。

          这里声明 USB_DEVICE_ATTACHED 是有意为之，而且是为了**少点一次**：
          只有声明了具体的 USB 设备，系统那个权限弹窗才会带「总是允许」的勾选框，
          勾一次以后就不再问。不声明的话每次插拔都要重新授权。
          （早先不声明是因为每插一次系统会再拉起一个实例、把原连接顶掉；
           现在连接状态在 RfidSession 单例里，加上 singleTop，重复拉起已经无害。）
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <!-- 这个 meta-data 必须是 <activity> 的直接子元素，不能放进 intent-filter 里 -->
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_device_filter" />
        </activity>

        <!--
          CloudActivity 在 1.1.0 被 Compose 那边的 LibraryScreen 取代了，条目已删。
          留这条注释是为了以后 grep 到 .CloudActivity 时知道它是去哪了。
        -->
    </application>

</manifest>
